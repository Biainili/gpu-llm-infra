worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/json;

    server_tokens off;
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 10m;

    map $http_authorization $is_authorized {
        default 0;
        "Bearer {{ llm_api_key }}" 1;
    }

    limit_req_zone $binary_remote_addr zone=llm_api_limit:10m rate={{ nginx_rate_limit }};
    limit_req_status 429;

    upstream ollama_backend {
        server {{ ollama_bind_address }}:{{ ollama_port }};
        keepalive 16;
    }

    server {
        listen {{ api_gateway_bind_address }}:{{ api_gateway_port }};
        server_name _;

        location = /health {
            access_log off;
            add_header Content-Type application/json always;
            return 200 '{"status":"healthy","service":"llm-api-gateway"}\n';
        }

        location / {
            if ($is_authorized = 0) {
                return 401 '{"error":"Unauthorized: valid Bearer token required"}\n';
            }

            limit_req zone=llm_api_limit burst={{ nginx_rate_limit_burst }} nodelay;

            proxy_pass http://ollama_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_connect_timeout 30s;
            proxy_send_timeout {{ nginx_proxy_read_timeout }};
            proxy_read_timeout {{ nginx_proxy_read_timeout }};
            proxy_buffering off;
        }
    }
}
